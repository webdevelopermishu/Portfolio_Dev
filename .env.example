# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio"
# Public base URL of the site, no trailing slash (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Secret used to sign admin sessions. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# ── Seed (only read by `npm run db:seed`) ───────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now-please"
SEED_DEVELOPER_NAME="Your Name"

# ── Email (Resend). Without a key, emails are logged to the server console ──
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend, e.g. "hello@yourdomain.com"
EMAIL_FROM="onboarding@resend.dev"

# ── File storage: "local" (default) or "cloudinary" ─────────────────────────
STORAGE_DRIVER="local"
# Local driver: directory for uploaded files (must be writable and persistent)
UPLOAD_DIR="./storage/uploads"
# Cloudinary driver
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="portfolio"
